# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Build output (large files exceeding GitHub 100MB limit)
release/

# Landing dynamically copied large installers (to prevent committing to GitHub)
landing/public/*.exe
landing/public/*.dmg
landing/public/*.AppImage

# Embedded Python runtime (downloaded by scripts/fetch-embedded-python.js)
vendor/

# Electron build output
dist-electron/

# Vault: encrypted API keys (DO NOT COMMIT)
sparta-vault.json

# App data directory
.sparta/


dist-web/

# MCP server config — may contain API keys/tokens; never commit real credentials
sparta.mcp.json

# Compiled native addons (platform-specific .node binaries)
desktop/runtime/**/*.node
*.node

# Lockfile consistency: project uses npm
pnpm-lock.yaml
.pnpm-virtual/
.pnpm-store/
yarn.lock

# Temporary build artifacts & timestamp files
*.timestamp-*.mjs
package.json.*
*.tmp


# Temporary / runtime files
.tmp/
build-log.txt
test-workspace-root.txt
test-agente.txt

# Python bytecode generated by the local backend
__pycache__/
*.py[cod]
