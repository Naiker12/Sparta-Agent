{
  "name": "sparta-agent",
  "private": true,
  "version": "0.1.8",
  "description": "Local-first agentic IDE for high-performance engineering teams",
  "author": "Naiker12",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Naiker12/Sparta-Agent.git"
  },
  "homepage": "https://github.com/Naiker12/Sparta-Agent#readme",
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b",
  "type": "module",
  "bin": {
    "sparta": "./bin/sparta.mjs"
  },
  "scripts": {
    "dev": "vite",
    "landing:dev": "pnpm --filter ./landing dev",
    "landing:build": "pnpm --filter ./landing build",
    "build": "tsc && node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build && node scripts/check-main-bundle.js && electron-builder --config electron-builder.config.cjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "preview": "vite preview",
    "sparta": "node ./bin/sparta.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node -e \"try { require('fs').rmSync('node_modules/.vite', { recursive: true, force: true }); console.log('✓ Vite cache cleaned'); } catch(e) { /* ignore */ }\"",
    "rebuild-native": "npx @electron/rebuild -f -w node-pty"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@firecrawl/anydoc": "^0.1.6",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@pierre/diffs": "^1.2.12",
    "@pierre/trees": "1.0.0-beta.6",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.101.1",
    "@tiptap/react": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "framer-motion": "^12.41.0",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.55.1",
    "motion-dom": "^12.0.0",
    "motion-utils": "^12.0.0",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-use-measure": "^2.1.7",
    "react-virtuoso": "^4.18.11",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "thinking-orbs": "^0.1.1",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/d3": "^7.4.3",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "playwright": "1.61.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.1.9"
  },
  "main": "dist-electron/electron-main.js"
}
