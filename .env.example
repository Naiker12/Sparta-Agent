# ==============================================================================
# Sparta Agent — Plantilla de Variables de Entorno (.env)
# Copia este archivo a `.env` y completa con tus credenciales reales.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Credenciales de Cliente Público OAuth (Google / Microsoft Graph)
# ------------------------------------------------------------------------------
# Google (Drive, Gmail, Calendar) — Crear en console.cloud.google.com (Desktop app)
GOOGLE_OAUTH_CLIENT_ID="936503366261-knedfmoqmibjqefepa766tdfpj26cl9m.apps.googleusercontent.com"

# Microsoft (OneDrive / SharePoint) — Crear en entra.microsoft.com (Public client)
MICROSOFT_OAUTH_CLIENT_ID="xxxx-xxxx-xxxx-xxxx"


# ------------------------------------------------------------------------------
# 2. Credenciales de Cliente Confidencial OAuth (Notion / Slack / Figma)
# ------------------------------------------------------------------------------
# Notion — Crear en notion.so/my-integrations (Public integration)
NOTION_OAUTH_CLIENT_ID="xxxx-xxxx-xxxx"

# Slack — Crear en api.slack.com/apps
SLACK_OAUTH_CLIENT_ID="xxxx.xxxx"

# Figma — Crear en figma.com/developers/apps
FIGMA_OAUTH_CLIENT_ID="xxxx-xxxx-xxxx"


# ------------------------------------------------------------------------------
# 3. URL del Broker Serverless (para Notion, Slack y Figma)
# ------------------------------------------------------------------------------
# Endpoint desplegado en Cloudflare Workers / Vercel Edge o localhost en desarrollo
SPARTA_OAUTH_BROKER_URL="https://oauth-broker.sparta-agent.workers.dev/api/oauth"
# Para desarrollo local con el broker corriendo en tu máquina:
# SPARTA_OAUTH_BROKER_URL="http://127.0.0.1:3000/api/oauth"


# ------------------------------------------------------------------------------
# 4. Token de Integración Interna Sentry (Reemplaza a OAuth)
# ------------------------------------------------------------------------------
# Crear en sentry.io -> Settings -> Developer Settings -> New Internal Integration
SENTRY_AUTH_TOKEN="sntrys_xxxx_xxxx"
